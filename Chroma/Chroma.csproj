<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImportBSMTTargets>true</ImportBSMTTargets>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GameDirectory Condition="!$(Configuration.EndsWith('1.45.1')) AND !$(Configuration.EndsWith('1.45.2')) AND '$(GameDirectory)' == ''">$(BeatSaberDir)</GameDirectory>
    <GameDirectory Condition="$(Configuration.EndsWith('1.45.1'))">D:\BSManager\BSInstances\1.45.1</GameDirectory>
    <GameDirectory Condition="$(Configuration.EndsWith('1.45.2'))">D:\BSManager\BSInstances\1.45.2</GameDirectory>
    <CopyPDB>false</CopyPDB>
    <DisableCopyToGame Condition="$(Configuration.EndsWith('1.45.1'))">false</DisableCopyToGame>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);LATEST</DefineConstants>
    <BeatSaberDir Condition="'$(BeatSaberDir)' == ''"></BeatSaberDir>
    <Configurations>Debug-1.29.1;Release-1.29.1;Debug-1.34.2;Release-1.34.2;Debug-1.37.1;Release-1.37.1;Debug-1.40.8;Release-1.40.8;Debug-1.42.1;Release-1.42.1;Debug-1.43.0;Release-1.43.0;Debug-1.45.0;Release-1.45.0;Debug-1.45.1;Release-1.45.1;Debug-1.45.2;Release-1.45.2</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <PluginId>Chroma</PluginId>
    <PluginName>Chroma</PluginName>
    <Author>Aeroluna</Author>
    <Version>2.9.22</Version>
    <Description>Chroma™ boasts the most power in color customization you've ever seen, allowing mappers to customize blocks, lights, sabers, and barriers into not just one but multiple colors!</Description>
  </PropertyGroup>
  <ItemGroup>
    <DependsOn Include="Heck" Version="^1.7.0"/>
    <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.6.3"/>
    <DependsOn Include="BSIPA" Version="^4.2.2"/>
    <DependsOn Include="CustomJSONData" Version="^2.6.3"/>
    <DependsOn Include="LookupID" Version="^1.0.1"/>
    <DependsOn Include="SiraUtil" Version="^3.0.5"/>
  </ItemGroup>

  <ItemDefinitionGroup>
    <Reference Private="False"/>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(GameDirectory)\Libs\0Harmony.dll"/>
    <Reference Include="BeatmapCore" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BeatmapCore.dll"/>
    <Reference Include="BGLib.AppFlow" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BGLib.AppFlow.dll" Publicize="true"/>
    <Reference Include="BGLib.DotnetExtension" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BGLib.DotnetExtension.dll"/>
    <Reference Include="BGLib.UnityExtension" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BGLib.UnityExtension.dll"/>
    <Reference Include="BeatSaber.Haptics" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\BeatSaber.Haptics.dll"/>
    <Reference Include="BSML" HintPath="$(GameDirectory)\Plugins\BSML.dll"/>
    <Reference Include="Colors" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Colors.dll" Publicize="true"/>
    <Reference Include="CustomJSONData" HintPath="$(GameDirectory)\Plugins\CustomJSONData.dll"/>
    <Reference Include="DataModels" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\DataModels.dll" Publicize="true"/>
    <Reference Include="GameplayCore" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\GameplayCore.dll"/>
    <Reference Include="HMLib" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\HMLib.dll"/>
    <Reference Include="HMRendering" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\HMRendering.dll" Publicize="true"/>
    <Reference Include="IPA.Loader" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\IPA.Loader.dll"/>
    <Reference Include="Main" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Main.dll" Publicize="true"/>
    <Reference Include="Newtonsoft.Json" HintPath="$(GameDirectory)\Libs\Newtonsoft.Json.dll"/>
    <Reference Include="Rendering" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Rendering.dll" Publicize="true"/>
    <Reference Include="SiraUtil" HintPath="$(GameDirectory)\Plugins\SiraUtil.dll"/>
    <Reference Include="Tweening" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Tweening.dll"/>
    <Reference Include="Unity.Addressables" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Unity.Addressables.dll"/>
    <Reference Include="Unity.ResourceManager" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Unity.ResourceManager.dll"/>
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll"/>
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.InputLegacyModule.dll"/>
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.ParticleSystemModule.dll"/>
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.PhysicsModule.dll"/>
    <Reference Include="UnityEngine.XRModule" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\UnityEngine.XRModule.dll"/>
    <Reference Include="Zenject" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Zenject.dll" Publicize="true"/>
    <Reference Include="Zenject-usage" HintPath="$(GameDirectory)\Beat Saber_Data\Managed\Zenject-usage.dll"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heck\Heck.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="LightIDTables\*.json"/>
    <EmbeddedResource Include="Settings\modifiers.bsml"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks.Luna" Version="2.1.0"/>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*"/>
    <PackageReference Include="LunaBSMod.Tasks" Version="1.1.0"/>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.354"/>
  </ItemGroup>
</Project>
